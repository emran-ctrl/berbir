# Copy to `.env` and adjust. Loaded automatically from the project root;
# real shell environment variables take precedence.

# Directory of extra Nuclei YAML templates to load at startup (in addition to
# the built-ins). Unset to run only the built-in templates.
BERBIR_TEMPLATES=/path/to/nuclei-templates/http

# Optional overrides (defaults shown):
# BERBIR_BIND=127.0.0.1:3000
# BERBIR_DB=sqlite:berbir.db?mode=rwc
# BERBIR_DIST=crates/app/dist
